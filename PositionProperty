<html>
<head>
<title>CSS Position Demo</title>

<style>
body {
    height: 1500px; /* for scrolling */
}

/* Common style */
.box {
    width: 150px;
    height: 80px;
    color: white;
    text-align: center;
    line-height: 80px;
}

/* Static (default) */
.static {
    position: static;
    background-color: gray;
}

/* Relative */
.relative {
    position: relative;
    left: 50px;
    top: 20px;
    background-color: blue;
}

/* Absolute */
.container {
    position: relative;
    border: 2px solid black;
    height: 200px;
    margin-top: 20px;
}

.absolute {
    position: absolute;
    top: 20px;
    right: 20px;
    background-color: red;
}

/* Fixed */
.fixed {
    position: fixed;
    top: 10px;
    right: 10px;
    background-color: green;
}

/* Sticky */
.sticky {
    position: sticky;
    top: 0;
    background-color: orange;
}
</style>

</head>

<body>

<h2>CSS Position Properties Demo</h2>

<!-- Static -->
<div class="box static">Static</div>

<!-- Relative -->
<div class="box relative">Relative</div>

<!-- Absolute -->
<div class="container">
    Container
    <div class="box absolute">Absolute</div>
</div>

<!-- Fixed -->
<div class="box fixed">Fixed</div>

<!-- Sticky -->
<div class="box sticky">Sticky</div>

<p>Scroll down to see sticky and fixed behavior...</p>

</body>
</html>
